# --- Core dotfile dependencies (referenced by shell/git/tmux/nvim configs) ---
# Organize software neatly under a single directory tree (dotfiles manager)
brew "stow"
# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Parser generator CLI; required by nvim-treesitter (main branch) to build parsers
brew "tree-sitter-cli"
# Terminal multiplexer
brew "tmux"
# Command-line fuzzy finder written in Go
brew "fzf"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# Cross-shell prompt for astronauts
brew "starship"
# Shell extension to navigate your filesystem faster
brew "zoxide"
# Fast and simple Node.js version manager
brew "fnm"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# GNU awk utility
brew "gawk"
# Lightweight and flexible command-line JSON processor
brew "jq"
# GitHub command-line tool
brew "gh"
# Static analysis and lint tool, for (ba)sh scripts
brew "shellcheck"
# Fish-like autosuggestions for zsh (sourced in .zshrc)
brew "zsh-autosuggestions"
# Fish shell-like syntax highlighting for zsh (sourced in .zshrc)
brew "zsh-syntax-highlighting"
# Interactive git diff pager (git pager in .gitconfig)
brew "modem-dev/tap/hunk"
# Change the theme of your terminal and more (terminal theming engine)
brew "tinted-theming/tinted/tinty"

# --- Daily-driver CLI tools ---
# Simple terminal UI for git commands
brew "lazygit"
# Blazing fast terminal file manager written in Rust, based on async I/O
brew "yazi"
# Process YAML, JSON, XML, CSV and properties documents from the CLI
brew "yq"
# Improved top (interactive process viewer)
brew "htop"
# Internet file retriever
brew "wget"
# GNU Privacy Guard (OpenPGP)
brew "gnupg"
# CLI proxy to minimize LLM token consumption
brew "rtk"
# Stack changes and submit them for review on GitHub
brew "withgraphite/tap/graphite"
# Command-line interface for ConductorOne
brew "conductorone/cone/cone"

# --- macOS window management ---
# Simple hotkey-daemon for macOS.
brew "koekeishiya/formulae/skhd"
# A tiling window manager for macOS based on binary space partitioning.
brew "koekeishiya/formulae/yabai"

